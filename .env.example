# Copy to .env and adjust. Every setting is optional.

# Use a long random value in any shared deployment
FENRIX_JWT_SECRET=change-me-in-production

# Demo login
FENRIX_DEMO_EMAIL=analyst@fenrix.dev
FENRIX_DEMO_PASSWORD=fenrix-demo

# SQLite by default; PostgreSQL works too:
# FENRIX_DATABASE_URL=postgresql+psycopg://fenrix:fenrix@localhost:5432/fenrix

# Query OSV and the npm/PyPI registries live (needs internet). Off = offline snapshot.
FENRIX_LIVE_FEEDS=false

# Local LLM for migration code (free, runs on your machine via Ollama)
FENRIX_LLM_ENABLED=true
FENRIX_OLLAMA_URL=http://localhost:11434
FENRIX_OLLAMA_MODEL=qwen2.5-coder:7b

# Only needed when the dashboard runs on a different origin (npm run dev)
FENRIX_CORS_ORIGINS=http://localhost:3000
